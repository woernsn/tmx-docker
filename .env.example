# Copy to .env and replace both empty secrets before running Compose.
# openssl rand -hex 32 can generate each value.
PG_PASSWORD=
JWT_SECRET=

# All three application images share this tag. Prefer sha-<workflow-commit> for a
# fixed deployment; latest tracks the most recent successful main build.
IMAGE_TAG=latest

# Default: TMX at http://localhost:8080/ and the public viewer at /pub/.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080

# Management UI at /manage/ for providers, users, and tournament access.
# Set true when serving the manager through HTTPS.
MANAGER_COOKIE_SECURE=false
