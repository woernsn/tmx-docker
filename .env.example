# Copy to .env and replace both empty secrets before running Compose.
# openssl rand -hex 32 can generate each value.
PG_PASSWORD=
JWT_SECRET=

# Both application images share this tag. Prefer sha-<workflow-commit> for a
# fixed deployment; latest tracks the most recent successful main build.
IMAGE_TAG=latest

# Default: local access at http://localhost:8080/tmx/.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
