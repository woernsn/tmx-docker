# Copy this file to .env before starting the stack.
# You MUST set the blank values in the required section.
# Generate separate random values for PG_PASSWORD, JWT_SECRET, and HIVEID_SIGNER_TOKEN.
# Run openssl rand -hex 32 once for each value.

# Required secrets and signing keys

# Password for the PostgreSQL user "tmx".
# A new installation needs a random value.
# An existing database volume needs the password that PostgreSQL already uses.
PG_PASSWORD=

# Legacy secret still required by CFS at startup.
# This stack sets JWT_ACCEPT_HS256=false, so CFS rejects tokens signed with this secret.
# This value needs to differ from PG_PASSWORD and HIVEID_SIGNER_TOKEN.
JWT_SECRET=

# Shared secret that CFS sends to HiveID when requesting a tournament token.
# This value needs to differ from the other secrets.
# Compose gives the same value to CFS and HiveID.
HIVEID_SIGNER_TOKEN=

# Key ID: a public name for the current ES256 signing key pair.
# HiveID puts this value in each token header, and CFS uses it to select the public key.
# Any stable, non-empty identifier is valid, such as "tmx-current".
# A stable value preserves sessions while the same key pair is in use.
# Changing this value or the key pair invalidates existing sessions in this stack.
JWT_KID=tmx-current

# Private PEM key used only by HiveID to sign tokens.
# The commands in README.md generate a P-256 key pair.
# The entire private PEM MUST be on one line, with each line ending encoded as the two characters \n.
# This key MUST belong to the same pair as JWT_PUBLIC_KEY.
# This key MUST stay private.
JWT_PRIVATE_KEY=

# Public PEM key for the same key pair.
# HiveID publishes it, and CFS uses it to verify tokens.
# The entire public PEM MUST be on one line, with each line ending encoded as \n.
JWT_PUBLIC_KEY=

# Optional HiveID integrations

# API key for the Resend email service.
# An empty value disables password reset, magic-link, and verification emails.
RESEND_API_KEY=

# Sender email address for HiveID emails, such as auth@example.com.
# Email flows need this address together with RESEND_API_KEY.
EMAIL_FROM=

# Base URL where HiveID can reach a separate courthive-persons service.
# An empty value leaves personal HiveID self-signup disabled.
PERSONS_BASE_URL=

# Shared service token for HiveID calls to courthive-persons.
# This value MUST match the token on that service when PERSONS_BASE_URL is set.
PERSONS_SERVICE_TOKEN=

# Application images

# The value "latest" selects the most recently published set of all four application images.
# A value of "sha-<repository-commit>" selects one published build for all four images.
# This value does not select the upstream source tags in sources.env.
IMAGE_TAG=latest

# Public address

# Host port for the web service.
# Any free host port can replace 8080.
HTTP_PORT=8080

# Host address for the web service.
# 127.0.0.1 allows access from this machine only.
# 0.0.0.0 allows access through other network interfaces.
BIND_ADDRESS=127.0.0.1

# Exact browser-visible scheme, host, and optional port, without a trailing slash.
# A reverse proxy needs its external HTTPS origin here.
# CFS uses it for allowed browser origins, and HiveID uses it for email links.
PUBLIC_ORIGIN=http://localhost:8080

# Manager session cookie

# The value false allows the manager cookie over local HTTP.
# You MUST set this to true for HTTPS so browsers send the cookie only over HTTPS.
MANAGER_COOKIE_SECURE=false
