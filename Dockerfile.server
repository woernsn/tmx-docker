# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@12.5.1
COPY --from=source / /app/

# Resolve published CourtHive packages without upstream's sibling workspace.
RUN sed -i '/link:\.\.\//d' pnpm-workspace.yaml \
    && HUSKY=0 pnpm install --no-frozen-lockfile \
    && pnpm build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NODE_PATH=/app/build
COPY --from=build /app /app
EXPOSE 8383
CMD ["sh", "-c", "if [ -f build/src/main.js ]; then exec node build/src/main.js; else exec node build/main.js; fi"]
