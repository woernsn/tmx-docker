# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@12.11.2
COPY --from=source / /app/

# Use published packages in place of upstream's sibling development checkouts.
RUN sed -i '/link:\.\.\//d' pnpm-workspace.yaml \
    && HUSKY=0 pnpm install --no-frozen-lockfile

# The viewer uses window.dev.baseURL for its API and Socket.IO connections.
# Point it at this deployment's origin before its application bundle loads.
COPY pub-config.js /app/public/tmx-docker-config.js
RUN sed -i 's#</head>#<script src="/pub/tmx-docker-config.js"></script></head>#' index.html
ENV BASE_URL=pub ENVIRONMENT=production VITE_SERVER=
RUN pnpm build

FROM nginx:stable-alpine
COPY nginx.pub.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
